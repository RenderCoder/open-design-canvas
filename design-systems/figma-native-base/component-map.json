    },
    {
      "slot": "faq.item",
      "figmaName": "FAQItem / Default",
      "search": ["FAQItem Default", "FAQItem / Default", "FAQ Item", "Accordion Item"],
      "fallback": {
        "nodeType": "FRAME",
        "autoLayout": "VERTICAL",
        "textStyle": "Text/Body/Medium",
        "padding": ["space/16", "space/0"],
        "itemSpacing": "space/8",
        "reportAs": "FAQItem / Default fallback"
      }
    }
  ],
  "reporting": {
    "fallbacksField": "hardcodedValues",
    "missingLibrariesField": "knownIssues",
    "requiredResultFields": [
      "reusedComponents",
      "variablesUsed",
      "stylesUsed",
      "hardcodedValues",
      "checks",
      "knownIssues"
    ]
  }
}
