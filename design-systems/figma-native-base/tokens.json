{
  "$schema": "https://open-design.local/schemas/figma-design-system-tokens.v1.json",
  "name": "figma-native-base",
  "description": "Neutral Figma-native tokens for editable canvas generation.",
  "modes": ["light"],
  "variables": {
    "color/bg/default": {
      "type": "color",
      "value": "#F8F7F4",
      "description": "Default page and canvas background."
    },
    "color/bg/subtle": {
      "type": "color",
      "value": "#EFEEE9",
      "description": "Alternate section background."
    },
    "color/surface/default": {
      "type": "color",
      "value": "#FFFFFF",
      "description": "Default card, modal, and control surface."
    },
    "color/surface/elevated": {
      "type": "color",
      "value": "#FCFCFA",
      "description": "Slightly raised nested surface."
    },
    "color/text/primary": {
      "type": "color",
      "value": "#151515",
      "description": "Primary foreground text."
    },
    "color/text/secondary": {
      "type": "color",
      "value": "#5F6368",
      "description": "Secondary text and metadata."
    },
    "color/text/inverse": {
      "type": "color",
      "value": "#FFFFFF",
      "description": "Text on dark or primary action fills."
    },
    "color/border/default": {
      "type": "color",
      "value": "#E4E1DA",
      "description": "Default divider and control border."
    },
    "color/action/primary": {
      "type": "color",
      "value": "#2563EB",
      "description": "Primary action fill."
    },
    "color/action/primary-hover": {
      "type": "color",
      "value": "#1D4ED8",
      "description": "Primary action hover fill."
    },
    "color/status/success": {
      "type": "color",
      "value": "#15803D",
      "description": "Success state."
    },
    "color/status/warning": {
      "type": "color",
      "value": "#B45309",
      "description": "Warning state."
    },
    "color/status/danger": {
      "type": "color",
      "value": "#DC2626",
      "description": "Danger or destructive state."
    },
    "space/0": { "type": "number", "value": 0 },
    "space/2": { "type": "number", "value": 2 },
    "space/4": { "type": "number", "value": 4 },
    "space/8": { "type": "number", "value": 8 },
    "space/12": { "type": "number", "value": 12 },
    "space/16": { "type": "number", "value": 16 },
    "space/24": { "type": "number", "value": 24 },
    "space/32": { "type": "number", "value": 32 },
    "space/48": { "type": "number", "value": 48 },
    "radius/0": { "type": "number", "value": 0 },
    "radius/4": { "type": "number", "value": 4 },
    "radius/8": { "type": "number", "value": 8 },
    "radius/12": { "type": "number", "value": 12 },
    "radius/16": { "type": "number", "value": 16 },
    "text/display/lg": {
      "type": "textStyle",
      "fontFamily": "Inter",
      "fontSize": 64,
      "lineHeight": 1.02,
      "fontWeight": 650
    },
    "text/display/md": {
      "type": "textStyle",
      "fontFamily": "Inter",
      "fontSize": 48,
      "lineHeight": 1.06,
      "fontWeight": 650
    },
    "text/heading/lg": {
      "type": "textStyle",
      "fontFamily": "Inter",
      "fontSize": 32,
      "lineHeight": 1.15,
      "fontWeight": 650
    },
    "text/heading/md": {
      "type": "textStyle",
      "fontFamily": "Inter",
      "fontSize": 24,
      "lineHeight": 1.2,
      "fontWeight": 650
    },
    "text/body/md": {
      "type": "textStyle",
      "fontFamily": "Inter",
      "fontSize": 16,
      "lineHeight": 1.55,
      "fontWeight": 400
    },
    "text/body/sm": {
      "type": "textStyle",
      "fontFamily": "Inter",
      "fontSize": 14,
      "lineHeight": 1.45,
      "fontWeight": 400
    },
    "text/caption": {
      "type": "textStyle",
      "fontFamily": "Inter",
      "fontSize": 12,
      "lineHeight": 1.35,
      "fontWeight": 500
    }
  },
  "styles": {
    "Text/Display/Large": { "token": "text/display/lg" },
    "Text/Display/Medium": { "token": "text/display/md" },
    "Text/Heading/Large": { "token": "text/heading/lg" },
    "Text/Heading/Medium": { "token": "text/heading/md" },
    "Text/Body/Medium": { "token": "text/body/md" },
    "Text/Body/Small": { "token": "text/body/sm" },
    "Text/Caption": { "token": "text/caption" },
    "Effect/Focus Ring": {
      "type": "effect",
      "description": "2px primary action outline for focused controls."
    },
    "Grid/Desktop/12": {
      "type": "layoutGrid",
      "columns": 12,
      "gutter": 24,
      "margin": 80
    },
    "Grid/Mobile/4": {
      "type": "layoutGrid",
      "columns": 4,
      "gutter": 16,
      "margin": 24
    }
  }
}
