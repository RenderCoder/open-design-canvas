{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FigmaNativeResult",
  "type": "object",
  "required": [
    "kind",
    "status"
  ],
  "properties": {
    "kind": {
      "const": "figma_native_result"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "fileUrl": {
      "type": "string"
    },
    "fileKey": {
      "type": "string"
    },
    "pageName": {
      "type": "string"
    },
    "rootFrames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeRef"
      }
    },
    "rootFrame": {
      "$ref": "#/$defs/nodeRef",
      "description": "Legacy singular alias accepted by parsers and normalized to rootFrames."
    },
    "created": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeRef"
      }
    },
    "updated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeRef"
      }
    },
    "reusedComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variablesUsed": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to variables.",
      "items": {
        "type": "string"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stylesUsed": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to styles.",
      "items": {
        "type": "string"
      }
    },
    "hardcodedValues": {
      "type": "array",
      "items": {}
    },
    "checks": {
      "type": "object",
      "properties": {
        "metadata": {
          "$ref": "#/$defs/checkStatus"
        },
        "screenshot": {
          "$ref": "#/$defs/checkStatus"
        },
        "variables": {
          "$ref": "#/$defs/checkStatus"
        },
        "autoLayout": {
          "$ref": "#/$defs/checkStatus"
        },
        "semanticNames": {
          "$ref": "#/$defs/checkStatus"
        }
      },
      "additionalProperties": true
    },
    "issues": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string"
              },
              "nodeId": {
                "type": "string"
              },
              "check": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "knownIssues": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to issues.",
      "items": {
        "type": "string"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextIteration": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to nextActions.",
      "items": {
        "type": "string"
      }
    },
    "mcpEvents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "checkStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "unknown"
      ]
    },
    "nodeRef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
