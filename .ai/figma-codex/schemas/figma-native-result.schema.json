{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FigmaNativeResult",
  "type": "object",
  "required": [
    "kind",
    "status"
  ],
  "properties": {
    "kind": {
      "const": "figma_native_result"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "fileUrl": {
      "type": "string"
    },
    "fileKey": {
      "type": "string"
    },
    "pageName": {
      "type": "string"
    },
    "rootFrames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeRef"
      }
    },
    "rootFrame": {
      "$ref": "#/$defs/nodeRef",
      "description": "Legacy singular alias accepted by parsers and normalized to rootFrames."
    },
    "created": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeRef"
      }
    },
    "updated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeRef"
      }
    },
    "reusedComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variablesUsed": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to variables.",
      "items": {
        "type": "string"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stylesUsed": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to styles.",
      "items": {
        "type": "string"
      }
    },
    "hardcodedValues": {
      "type": "array",
      "items": {}
    },
    "checks": {
      "type": "object",
      "properties": {
        "metadata": {
          "$ref": "#/$defs/checkStatus"
        },
        "screenshot": {
          "$ref": "#/$defs/checkStatus"
        },
        "variables": {
          "$ref": "#/$defs/checkStatus"
        },
        "autoLayout": {
          "$ref": "#/$defs/checkStatus"
        },
        "semanticNames": {
          "$ref": "#/$defs/checkStatus"
        },
        "textReadability": {
          "$ref": "#/$defs/checkStatus",
          "description": "Overall visible TEXT node readability gate."
        },
        "textOverlap": {
          "$ref": "#/$defs/checkStatus",
          "description": "TEXT-vs-TEXT overlap subcheck. Non-text overlaps are not failures."
        }
      },
      "additionalProperties": true
    },
    "issues": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string"
              },
              "nodeId": {
                "type": "string"
              },
              "check": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "readabilityCheck": {
      "$ref": "#/$defs/readabilityCheck"
    },
    "textOverlapCheck": {
      "$ref": "#/$defs/readabilityCheck"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshotResult"
    },
    "knownIssues": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to issues.",
      "items": {
        "type": "string"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextIteration": {
      "type": "array",
      "description": "Legacy alias accepted by parsers and normalized to nextActions.",
      "items": {
        "type": "string"
      }
    },
    "mcpEvents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "checkStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "unknown"
      ]
    },
    "nodeRef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "readabilityCheck": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/checkStatus"
        },
        "repairAttempts": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "fixedNodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remainingNodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoredCount": {
          "type": "number",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "snapshotResult": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "degraded",
            "failed",
            "skipped"
          ]
        },
        "fileName": {
          "type": "string",
          "pattern": "^figma-[0-9]{8}-[0-9]{6}-[a-z0-9][a-z0-9-]{0,47}(?:-[0-9]+)?\\.png$",
          "maxLength": 96
        },
        "projectRelativePath": {
          "type": "string"
        },
        "pixelWidth": {
          "type": "number",
          "minimum": 1
        },
        "pixelHeight": {
          "type": "number",
          "minimum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "expectedMinWidth": {
          "type": "number",
          "minimum": 1
        },
        "actualWidth": {
          "type": "number",
          "minimum": 1
        },
        "actualHeight": {
          "type": "number",
          "minimum": 1
        },
        "qualityStatus": {
          "enum": [
            "high_resolution",
            "degraded",
            "low_resolution",
            "failed",
            "skipped"
          ]
        },
        "sourceFileKey": {
          "type": "string"
        },
        "sourceNodeId": {
          "type": "string"
        },
        "sourceNodeName": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string"
        },
        "purposeSlug": {
          "type": "string",
          "maxLength": 48
        },
        "exportMethod": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
